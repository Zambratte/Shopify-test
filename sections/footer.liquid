<footer class="footer">
  <div class="page-width">
    <div class="footer-grid">
      <div class="footer-intro">
        <h2>{{ section.settings.heading | escape }}</h2>
        <p>{{ section.settings.text | escape }}</p>
      </div>
      {% for block in section.blocks %}
        <div class="footer-column" {{ block.shopify_attributes }}>
          <strong>{{ block.settings.heading | escape }}</strong>
          {% for link in block.settings.menu.links %}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
    <div class="footer-bottom">
      © {{ 'now' | date: '%Y' }} {{ shop.name | escape }} · {{ 'footer.general.legal_line' | t }}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Räume, die bleiben. Momente, die zählen."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Kuratiertes Design für Outdoor-Living und ein besonderes Zuhause."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menüspalte",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menü"
        }
      ]
    }
  ]
}
{% endschema %}
