<section>
  <header class="collection-header">
    <div class="eyebrow">{{ 'collections.general.discover' | t }}</div>
    <h1>{{ collection.title | escape }}</h1>
    {% if collection.description != blank %}
      <div class="rte">{{ collection.description }}</div>
    {% endif %}
  </header>

  {% paginate collection.products by section.settings.products_per_page %}
    <div class="page-width product-grid collection-grid">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <p>{{ 'collections.general.empty' | t }}</p>
      {% endfor %}
      {% if paginate.pages > 1 %}
        <div class="pagination">{{ paginate | default_pagination }}</div>
      {% endif %}
    </div>
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Kollektion",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12,
      "label": "Produkte pro Seite"
    }
  ]
}
{% endschema %}
