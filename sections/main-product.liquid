<section class="page-width product-page">
  <div class="product-gallery" aria-label="{{ 'products.product.media_gallery' | t }}">
    {% for image in product.images %}
      {{
        image
        | image_url: width: 1400
        | image_tag:
          loading: 'lazy',
          widths: '500, 800, 1100, 1400',
          sizes: '(max-width: 900px) calc(100vw - 30px), 55vw',
          alt: image.alt
      }}
    {% else %}
      <div class="product-media">
        <div class="placeholder">{{ 'products.product.image_placeholder' | t }}</div>
      </div>
    {% endfor %}
  </div>

  <div class="product-info">
    {% if product.vendor != blank %}
      <div class="eyebrow">{{ product.vendor | escape }}</div>
    {% endif %}
    <h1>{{ product.title | escape }}</h1>
    <div class="product-price" data-product-price>
      {{ product.selected_or_first_available_variant.price | money }}
    </div>
    <div class="rte">{{ product.description }}</div>

    {% form 'product', product, class: 'product-form' %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

      {% unless product.has_only_default_variant %}
        <label for="variant-{{ section.id }}">{{ 'products.product.variant' | t }}</label>
        <select id="variant-{{ section.id }}" data-variant-select>
          {% for variant in product.variants %}
            <option
              value="{{ variant.id }}"
              data-price="{{ variant.price | money }}"
              {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
              {% unless variant.available %}disabled{% endunless %}
            >
              {{ variant.title | escape }}
              {% unless variant.available %} – {{ 'products.product.sold_out' | t }}{% endunless %}
            </option>
          {% endfor %}
        </select>
      {% endunless %}

      <button class="button" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
        {% if product.selected_or_first_available_variant.available %}
          {{ 'products.product.add_to_cart' | t }}
        {% else %}
          {{ 'products.product.sold_out' | t }}
        {% endif %}
      </button>
      {{ form | payment_button }}
    {% endform %}

    <div class="assurances">
      <div>✓ {{ 'products.assurances.delivery' | t }}</div>
      <div>✓ {{ 'products.assurances.support' | t }}</div>
      <div>✓ {{ 'products.assurances.returns' | t }}</div>
      <div>✓ {{ 'products.assurances.warranty' | t }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produktinformationen",
  "settings": []
}
{% endschema %}
