<section
  class="hero"
  {% if section.settings.image %}
    style="--hero-image: url('{{ section.settings.image | image_url: width: 2400 }}')"
  {% endif %}
>
  <div class="page-width">
    <div class="hero-content">
      {% if section.settings.eyebrow != blank %}
        <div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>
      {% endif %}
      <h1>{{ section.settings.heading | escape }}</h1>
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text | escape }}</p>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="button button--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Premium Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hintergrundbild"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine Überschrift",
      "default": "Für draußen gemacht. Für zuhause gedacht."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Außergewöhnliche Stücke für ein Leben mit Weitblick."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Langlebige Outdoor- und Home-Objekte, persönlich ausgewählt und sicher bis zu Ihnen geliefert."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Kollektion entdecken"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button-Link"
    }
  ],
  "presets": [
    {
      "name": "Premium Hero"
    }
  ]
}
{% endschema %}
