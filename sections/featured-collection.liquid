<section class="section">
  <div class="page-width">
    <div class="section-head">
      <div>
        {% if section.settings.eyebrow != blank %}
          <div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>
        {% endif %}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      </div>
      {% if section.settings.collection != blank %}
        <a class="section-link" href="{{ section.settings.collection.url }}">{{ 'collections.general.view_all' | t }} →</a>
      {% endif %}
    </div>

    <div class="product-grid">
      {% for product in section.settings.collection.products limit: section.settings.limit %}
        {% render 'product-card', product: product %}
      {% else %}
        {% for index in (1..3) %}
          <div class="product-card">
            <div class="product-media">
              <div class="placeholder">{{ 'products.product.demo_name' | t }} {{ index }}</div>
            </div>
            <div class="product-meta">
              <h3>{{ 'products.product.demo_title' | t }}</h3>
              <span class="price">1.299 €</span>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ausgewählte Kollektion",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine Überschrift",
      "default": "Kuratiert für Sie"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Signature Pieces"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Kollektion"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 3,
      "max": 9,
      "step": 3,
      "default": 3,
      "label": "Produkte"
    }
  ],
  "presets": [
    {
      "name": "Ausgewählte Kollektion"
    }
  ]
}
{% endschema %}
