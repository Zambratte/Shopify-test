<header class="site-header">
  <div class="page-width header-inner">
    <a class="logo" href="{{ routes.root_url }}">{{ section.settings.logo_text | default: shop.name | escape }}</a>

    <nav class="nav" aria-label="{{ 'accessibility.main_navigation' | t }}">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
      {% endfor %}
    </nav>

    <div class="header-actions">
      <a class="desktop-search" href="{{ routes.search_url }}">{{ 'general.search.search' | t }}</a>
      <a href="{{ routes.cart_url }}">
        {{ 'general.cart.view' | t }}
        <span class="cart-count" aria-label="{{ 'general.cart.item_count' | t: count: cart.item_count }}">{{ cart.item_count }}</span>
      </a>
      <details class="mobile-menu">
        <summary>{{ 'accessibility.menu' | t }}</summary>
        <nav class="mobile-nav" aria-label="{{ 'accessibility.mobile_navigation' | t }}">
          {% for link in section.settings.menu.links %}
            <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
          {% endfor %}
          <a href="{{ routes.search_url }}">{{ 'general.search.search' | t }}</a>
        </nav>
      </details>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Markenname",
      "default": "NORTH & HEARTH"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menü",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
