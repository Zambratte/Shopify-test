{% if section.settings.text != blank %}
  <div class="announcement">{{ section.settings.text | escape }}</div>
{% endif %}

{% schema %}
{
  "name": "Hinweisleiste",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Kostenlose Premium-Lieferung ab 500 € · Persönliche Beratung inklusive"
    }
  ]
}
{% endschema %}
