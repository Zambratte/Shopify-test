<section class="hero" {% if section.settings.image %}style="--hero-image:url('{{ section.settings.image | image_url: width: 2200 }}')"{% endif %}>
  <div class="page-width"><div class="hero-content">
    <div class="eyebrow">{{ section.settings.eyebrow }}</div>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    <a class="button button--light" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
  </div></div>
</section>
{% schema %}{"name":"Premium Hero","settings":[{"type":"image_picker","id":"image","label":"Hintergrundbild"},{"type":"text","id":"eyebrow","label":"Kleine Überschrift","default":"Für draußen gemacht. Für zuhause gedacht."},{"type":"text","id":"heading","label":"Überschrift","default":"Außergewöhnliche Stücke für ein Leben mit Weitblick."},{"type":"textarea","id":"text","label":"Text","default":"Langlebige Outdoor- und Home-Objekte, persönlich ausgewählt und sicher bis zu Ihnen geliefert."},{"type":"text","id":"button_label","label":"Button","default":"Kollektion entdecken"},{"type":"url","id":"button_link","label":"Button-Link"}],"presets":[{"name":"Premium Hero"}]}{% endschema %}
