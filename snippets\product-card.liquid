<a class="product-card" href="{{ product.url }}">
  <div class="product-media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900' }}{% else %}<div class="placeholder">Bild folgt</div>{% endif %}</div>
  <div class="product-meta"><h3>{{ product.title }}</h3><span class="price">{{ product.price | money }}</span></div>
</a>
